# பட்டியல் மற்றும் நிபந்தனைகள் (lists + conditionals)
வை எண்கள் = [4, 9, 1, 7, 2]
சேர்(எண்கள், 15)
அச்சிடு("பட்டியல்:", எண்கள்)
அச்சிடு("நீளம்:", நீளம்(எண்கள்))
அச்சிடு("வரிசைப்படுத்தியது:", வரிசைப்படுத்து(எண்கள்))

ஒவ்வொன்றாக n இல் எண்கள் {
    என்றால் (n % 2 == 0) {
        அச்சிடு(n, "- இரட்டைப்படை (even)")
    } இல்லை {
        அச்சிடு(n, "- ஒற்றைப்படை (odd)")
    }
}
